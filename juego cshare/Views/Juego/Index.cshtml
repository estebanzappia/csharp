@{
    ViewData["Title"] = "Adivina el Número - Inicio";
}

<div class="container mt-5 text-center">
    <div class="card shadow p-4 mx-auto" style="max-width: 500px;">
        <h2 class="mb-3">🎲 Adivina el Número</h2>
        <p class="text-muted">Adivina un número entre el 1 y el 100. Tienes un máximo de 7 intentos.</p>

        @if (ViewBag.Error != null)
        {
            <div class="alert alert-danger">@ViewBag.Error</div>
        }

        <form asp-action="Iniciar" method="post">
            <div class="mb-3">
                <label for="jugador" class="form-label">Tu Nombre o Apodo:</label>
                <input type="text" class="form-control text-center" id="jugador" name="jugador" required maxlength="20" placeholder="Ej. Jugador1">
            </div>
            <button type="submit" class="btn btn-primary w-100">Comenzar Partida</button>
        </form>

        <div class="mt-3">
            <a asp-action="Ranking" class="btn btn-outline-secondary btn-sm">Ver Ranking (Top 10)</a>
        </div>
    </div>
</div>