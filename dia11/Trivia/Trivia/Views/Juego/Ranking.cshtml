Views/Juego/Ranking.cshtml

@model List<Puntaje>
@{
    ViewData["Title"] = "Ranking";
}

<h1>Ranking</h1>

<table class="table table-striped">
    <thead>
        <tr>
            <th>Puesto</th>
            <th>Jugador</th>
            <th>Puntos</th>
        </tr>
    </thead>
    <tbody>
        @for (int i = 0; i < Model.Count; i++)
        {
            <tr>
                <td>@(i + 1)</td>
                <td>@Model[i].Jugador</td>
                <td>@Model[i].Puntos</td>
            </tr>
        }
    </tbody>
</table>

<a asp-action="Index" class="btn btn-primary">Jugar</a>