@model Movimiento
@{
    ViewData["Title"] = "Eliminar movimiento";
}

<div class="max-w-xl mx-auto">
    <h1 class="text-3xl font-bold text-slate-900 mb-6 text-center">Eliminar movimiento</h1>

    <div class="rounded-2xl bg-white p-8 shadow-sm border border-red-200 space-y-6">
        <p class="text-center text-base text-slate-700">¿Seguro que quieres eliminar este movimiento?</p>

        <dl class="divide-y divide-slate-100 rounded-xl bg-slate-50 px-6 py-2">
            <div class="grid grid-cols-3 gap-4 py-4">
                <dt class="text-sm font-semibold text-slate-500">Tipo</dt>
                <dd class="col-span-2 text-sm font-medium text-slate-800">@Model.Tipo</dd>
            </div>
            <div class="grid grid-cols-3 gap-4 py-4">
                <dt class="text-sm font-semibold text-slate-500">Descripción</dt>
                <dd class="col-span-2 text-sm font-medium text-slate-800">@Model.Descripcion</dd>
            </div>
            <div class="grid grid-cols-3 gap-4 py-4">
                <dt class="text-sm font-semibold text-slate-500">Monto</dt>
                <dd class="col-span-2 text-sm font-bold text-slate-900">@Model.Monto.ToString("N0") Gs</dd>
            </div>
        </dl>

        <form asp-action="DeleteConfirmed" method="post">
            <input type="hidden" name="id" value="@Model.Id" />
            <div class="flex items-center gap-3">
                <button type="submit" class="flex-1 rounded-xl bg-red-600 px-5 py-3 text-base font-semibold text-white shadow-sm hover:bg-red-700 transition">Sí, eliminar</button>
                <a asp-action="Index" class="flex-1 rounded-xl border border-slate-300 bg-white px-5 py-3 text-center text-base font-semibold text-slate-700 hover:bg-slate-50 transition">Cancelar</a>
            </div>
        </form>
    </div>
</div>