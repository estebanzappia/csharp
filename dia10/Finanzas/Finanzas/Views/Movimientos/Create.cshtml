@model Movimiento
@{
    ViewData["Title"] = "Nuevo movimiento";
}

<div class="max-w-xl mx-auto">
    <h1 class="text-3xl font-bold text-slate-900 mb-6 text-center">Nuevo movimiento</h1>

    <form asp-action="Create" method="post" class="rounded-2xl bg-white p-8 shadow-sm border border-slate-200 space-y-6">
        <div>
            <label asp-for="Tipo" class="block text-sm font-semibold text-slate-700 mb-2"></label>
            <select asp-for="Tipo" asp-items="Html.GetEnumSelectList<TipoMovimiento>()" class="block w-full rounded-xl border border-slate-300 bg-white px-4 py-3 text-base text-slate-800 focus:border-emerald-500 focus:outline-none focus:ring-2 focus:ring-emerald-200"></select>
        </div>
        <div>
            <label asp-for="Monto" class="block text-sm font-semibold text-slate-700 mb-2"></label>
            <input asp-for="Monto" class="block w-full rounded-xl border border-slate-300 px-4 py-3 text-base text-slate-800 focus:border-emerald-500 focus:outline-none focus:ring-2 focus:ring-emerald-200" />
            <span asp-validation-for="Monto" class="mt-2 block text-sm text-red-600"></span>
        </div>
        <div>
            <label asp-for="Descripcion" class="block text-sm font-semibold text-slate-700 mb-2"></label>
            <input asp-for="Descripcion" class="block w-full rounded-xl border border-slate-300 px-4 py-3 text-base text-slate-800 focus:border-emerald-500 focus:outline-none focus:ring-2 focus:ring-emerald-200" />
            <span asp-validation-for="Descripcion" class="mt-2 block text-sm text-red-600"></span>
        </div>
        <div class="flex items-center gap-3 pt-2">
            <button type="submit" class="flex-1 rounded-xl bg-emerald-600 px-5 py-3 text-base font-semibold text-white shadow-sm hover:bg-emerald-700 transition">Guardar</button>
            <a asp-action="Index" class="flex-1 rounded-xl border border-slate-300 bg-white px-5 py-3 text-center text-base font-semibold text-slate-700 hover:bg-slate-50 transition">Cancelar</a>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}