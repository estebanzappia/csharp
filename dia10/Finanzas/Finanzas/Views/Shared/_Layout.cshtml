<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Finanzas</title>
    <script type="importmap"></script>
    <script src="https://cdn.jsdelivr.net/npm/@@tailwindcss/browser@@4"></script>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/Finanzas.styles.css" asp-append-version="true" />
</head>
<body class="min-h-screen flex flex-col bg-slate-50 text-slate-800 antialiased">
    <header class="bg-white border-b border-slate-200 shadow-sm">
        <nav class="max-w-5xl mx-auto px-4 py-4 flex flex-wrap items-center justify-between gap-3">
            <a class="text-xl font-bold text-emerald-600 hover:text-emerald-700" asp-area="" asp-controller="Home" asp-action="Index">Finanzas</a>
            <ul class="flex items-center gap-1 text-sm font-medium">
                <li>
                    <a class="px-3 py-2 rounded-lg text-slate-600 hover:bg-slate-100 hover:text-slate-900" asp-area="" asp-controller="Home" asp-action="Index">Home</a>
                </li>
                <li>
                    <a class="px-3 py-2 rounded-lg text-slate-600 hover:bg-slate-100 hover:text-slate-900" asp-area="" asp-controller="Home" asp-action="Privacy">Privacy</a>
                </li>
                <li>
                    <a class="px-3 py-2 rounded-lg text-slate-600 hover:bg-slate-100 hover:text-slate-900" asp-area="" asp-controller="Movimientos" asp-action="Index">Movimientos</a>
                </li>
            </ul>
        </nav>
    </header>

    <main role="main" class="flex-1 w-full max-w-5xl mx-auto px-4 py-8">
        @RenderBody()
    </main>

    <footer class="border-t border-slate-200 bg-white text-sm text-slate-500">
        <div class="max-w-5xl mx-auto px-4 py-4">
            &copy; 2026 - Finanzas - <a class="text-emerald-600 hover:underline" asp-area="" asp-controller="Home" asp-action="Privacy">Privacy</a>
        </div>
    </footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>